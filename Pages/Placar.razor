@page "/placar"

<PageTitle>Placar Interativo</PageTitle>

<h1>Placar Interativo</h1>

<h2>Pontuação: @pontos</h2>

<div class="mt-3">
    <button class="btn btn-success me-2" @onclick="SomarUmPonto">Somar 1 Ponto</button>
    <button class="btn btn-warning me-2" @onclick="SubtrairUmPonto">Subtrair 1 Ponto</button>
    <button class="btn btn-danger" @onclick="ZerarPlacar">Zerar Placar</button>
</div>

@code {
    private int pontos = 0;

    private void SomarUmPonto()
    {
        pontos++;
    }

    private void SubtrairUmPonto()
    {
        if (pontos > 0)
        {
            pontos--;
        }
    }

    private void ZerarPlacar()
    {
        pontos = 0;
    }
}
