@page "/mensagem"

<PageTitle>Alternador de Mensagem</PageTitle>

<h1>Alternador de Mensagem</h1>

<button class="btn btn-secondary mb-3" @onclick="AlternarVisibilidade">
    @(exibirMensagem ? "Ocultar Mensagem" : "Exibir Mensagem")
</button>

@if (exibirMensagem)
{
    <p>Bem-vindo ao desenvolvimento web com .NET 10!</p>
}

@code {
    private bool exibirMensagem = false;

    private void AlternarVisibilidade()
    {
        exibirMensagem = !exibirMensagem;
    }
}
